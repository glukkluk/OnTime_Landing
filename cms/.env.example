# Connection string із Neon → Connect (база CMS із наявною схемою Payload).
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_ENDPOINT.neon.tech/neondb?sslmode=verify-full
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Дозволені адреси Vite без кінцевого /, через кому.
FRONTEND_URL=http://localhost:5173,http://localhost:4173
